# Coverage profiles are build output. CI produces and uploads them as an artifact, so
# a committed copy is only ever stale.
*.out
coverage
cov-src

# Binaries produced by `go build` without -o.
/foundation-platform
/archcheck

# Local configuration. .env holds a working database credential; .env.example is the
# committed template and carries a placeholder. This repository is public.
.env

# Scratch left by the Makefile.
.fmt.tmp
*.orig

# Editor and OS noise.
.idea/
.vscode/
*.swp
.DS_Store
Thumbs.db
