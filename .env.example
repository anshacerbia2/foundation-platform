# Copy to .env with `make env`, then set the password to your local one.
#
# .env is gitignored. This file is not, so it carries a placeholder rather than a working
# credential -- an earlier round of this shipped the real local password to three public
# repositories, and a template is exactly the file nobody thinks to check.

# The database the integration suite uses. It is DROPPED and rebuilt on every run:
# TestMain runs `DROP SCHEMA platform CASCADE` and re-applies migrations, because a suite
# that passes against a schema an earlier run left behind is not a test of the migrations.
#
# Point this at a throwaway database. Never at a development database you care about.
#
# Create it with: make db
TEST_DATABASE_URL=postgres://postgres:CHANGE_ME@localhost:5432/platform_test?sslmode=disable

# The superuser connection used only to CREATE the test databases. Same cluster, no
# specific database. Kept separate so `make db` can create what TEST_DATABASE_URL names.
ADMIN_DSN=postgres://postgres:CHANGE_ME@localhost:5432/postgres?sslmode=disable

# With TEST_DATABASE_URL unset the integration tests skip and the run is still green, which
# is indistinguishable from having proven anything. Setting this turns a skip into a
# failure. CI sets it; `make test-integration` and `make test-ci` set it for you.
# REQUIRE_INTEGRATION=1
